{
  "name": "dsh-claude-style",
  "description": "Claude Code Desktop theme for DeepSeek Harness (dsh) web GUI — visual & interaction overhaul",
  "version": "0.11.0",
  "type": "module",
  "main": "host/index.js",
  "icon": "lib/claude-mark.svg",
  "scripts": {
    "build": "node scripts/build.mjs",
    "probe": "node scripts/probe.cjs",
    "smoke": "node scripts/smoke.cjs",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": "./host/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.7"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "host",
    "lib",
    "locale",
    "skin.json",
    "cordis.patch.yml",
    "docs/STYLE.md",
    "docs/decisions",
    "CHANGELOG.md",
    "README.md",
    "README.en.md",
    "LICENSE",
    "fonts/JetBrainsMonoVariable.ttf",
    "fonts/JetBrainsMonoItalicVariable.ttf",
    "fonts/OFL.txt",
    "fonts/AUTHORS.txt",
    "fonts/InterVariable.woff2",
    "fonts/OFL-Inter.txt",
    "fonts/NotoSerifVariable.woff2",
    "fonts/OFL-NotoSerif.txt"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "web-ui",
    "theme",
    "claude",
    "claude-code",
    "desktop-theme",
    "anthropic",
    "editorial"
  ],
  "license": "MIT",
  "author": "Nwflower",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nwflower/dsh-claude-style.git"
  },
  "homepage": "https://github.com/Nwflower/dsh-claude-style#readme",
  "bugs": {
    "url": "https://github.com/Nwflower/dsh-claude-style/issues"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
