{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "status",
    "owner",
    "reviewer",
    "created",
    "updated",
    "branch",
    "worktree",
    "depends",
    "paths",
    "specs",
    "gate",
    "gateArgs",
    "behavior",
    "direction",
    "change",
    "adr",
    "noChangeReason",
    "measurements",
    "acceptance",
    "verification",
    "handoff",
    "history"
  ],
  "properties": {
    "schema": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "active", "review"] },
    "owner": { "type": "string" },
    "reviewer": { "type": ["string", "null"] },
    "created": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "branch": { "type": ["string", "null"] },
    "worktree": { "type": ["string", "null"] },
    "depends": { "type": "array", "items": { "type": "string" } },
    "paths": { "type": "array", "items": { "type": "string" } },
    "specs": { "type": "array", "items": { "type": "string" } },
    "gate": { "enum": ["bare", "quick", "feature", "full", "e2e"] },
    "gateArgs": { "type": "array", "items": { "type": "string" } },
    "behavior": { "type": "boolean" },
    "direction": { "type": "boolean" },
    "change": { "type": ["string", "null"] },
    "adr": { "type": ["string", "null"] },
    "noChangeReason": { "type": ["string", "null"] },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "value", "source", "enforced", "retire"],
        "properties": {
          "item": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "enforced": { "type": ["string", "null"] },
          "retire": { "enum": ["token", "test", "comment", "adr", "none", "pending"] },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "check"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "check": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "command", "result"],
        "properties": {
          "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "command": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "fail", "skip"] },
          "evidence": { "type": ["string", "null"] }
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "next", "blockers", "lastCommand"],
      "properties": {
        "state": { "type": "string" },
        "next": { "type": "string" },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "lastCommand": { "type": ["string", "null"] }
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "status", "by"],
        "properties": {
          "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "status": { "enum": ["draft", "active", "review"] },
          "by": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
