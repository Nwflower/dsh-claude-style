{
  "$schema": "./tokens.schema.json",
  "typeface": [
    {
      "token": "--dsw-font-family",
      "claude": "'Anthropic Sans Web Text','Claude Style Inter','Noto Sans SC','Source Han Sans SC',-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Hiragino Sans GB','Microsoft YaHei','Helvetica Neue',Helvetica,Arial,sans-serif"
    },
    {
      "token": "--dsh-claude-font-serif",
      "claude": "'Anthropic Serif Web Text','Claude Style Noto Serif',Georgia,'Times New Roman','Noto Sans SC','Source Han Sans SC','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif",
      "host": "var(--dsw-font-family)"
    },
    {
      "token": "--dsh-claude-font-prose",
      "claude": "'Anthropic Serif Web Text','Claude Style Noto Serif',Georgia,'Times New Roman','Noto Sans SC','Source Han Sans SC','PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif",
      "host": "var(--dsw-font-family)",
      "note": "Conversation prose: Claude sets Latin text in the serif face and lets Chinese fall through to a sans CJK — the serif Latin faces carry no CJK glyphs, so the stack leads with serif and names the sans CJK families after it. The interface keeps the sans stack; only Markdown prose uses this."
    },
    {
      "token": "--dsh-claude-font-code",
      "claude": "'JetBrains Mono','Noto Sans SC','Source Han Sans SC','PingFang SC','Hiragino Sans GB','Microsoft YaHei',ui-monospace,'SF Mono','Fira Code',Consolas,'Liberation Mono',Menlo,Courier,monospace",
      "host": "var(--ds-font-family-code)"
    },
    {
      "token": "--dsh-claude-font-brand",
      "claude": "'Anthropic Serif Web Text', var(--dsh-claude-font-serif)",
      "host": "var(--dsw-font-family)",
      "note": "Claude's lockup is drawn in Anthropic's serif, so its rows take the same face; the serif token stays behind it so a missing font degrades to the shipped serif."
    },
    {
      "token": "--dsw-font-markdown-h2",
      "claude": "700 calc(18px + var(--dsh-content-font-delta)) / calc(26px + var(--dsh-content-font-delta)) var(--dsh-claude-font-prose)",
      "note": "The host reads these through a `font:` shorthand that names --dsw-font-family directly, so overriding the `-font-family` sub-tokens never reached the page: the shorthand itself has to be re-declared."
    },
    {
      "token": "--dsw-font-markdown-h3",
      "claude": "700 calc(16px + var(--dsh-content-font-delta)) / calc(24px + var(--dsh-content-font-delta)) var(--dsh-claude-font-prose)"
    }
  ],
  "apex": [
    {
      "token": "--dsh-claude-apex",
      "dark": "#9d8ce0",
      "light": "#8b7ad0"
    },
    {
      "token": "--dsh-claude-apex-flash",
      "dark": "#e6e0fb",
      "light": "#d9d2f5"
    },
    {
      "token": "--dsh-claude-apex-ink",
      "dark": "#b9adf0",
      "light": "#5f51b5"
    }
  ],
  "palette": [
    {
      "token": "--dsw-alias-bg-base",
      "claude": { "dark": "#141413", "light": "#fcfcfb" },
      "deepseek": { "dark": "#13161d", "light": "#fafbff" }
    },
    {
      "token": "--dsw-alias-bg-layer-1",
      "claude": { "dark": "#1c1b1a", "light": "#fcfcfb" },
      "deepseek": { "dark": "#1a1e27", "light": "#fafbff" }
    },
    {
      "token": "--dsw-alias-bg-layer-2",
      "claude": { "dark": "#242320", "light": "#fbfbf9" },
      "deepseek": { "dark": "#212631", "light": "#f7f9ff" }
    },
    {
      "token": "--dsw-alias-bg-layer-3",
      "claude": { "dark": "#2e2c29", "light": "#f9f9f6" },
      "deepseek": { "dark": "#2a303c", "light": "#f4f7fe" }
    },
    {
      "token": "--dsw-alias-bg-overlay",
      "claude": { "dark": "#242320", "light": "#ffffff" },
      "deepseek": { "dark": "#212631" }
    },
    {
      "token": "--dsw-alias-border-l1",
      "claude": { "dark": "#242320", "light": "#e8e6dc" },
      "deepseek": { "dark": "#212631", "light": "#e7ecf7" }
    },
    {
      "token": "--dsw-alias-border-l2",
      "claude": { "dark": "#2e2c29", "light": "#dedcd2" },
      "deepseek": { "dark": "#2a303c", "light": "#dde4f1" }
    },
    {
      "token": "--dsw-alias-border-l3",
      "claude": { "dark": "#3a3833", "light": "#d0cdc1" },
      "deepseek": { "dark": "#363d4b", "light": "#cfd8ea" }
    },
    {
      "token": "--dsw-alias-brand-primary",
      "use": "the single accent: checks, focus rings, selected marks",
      "claude": { "dark": "#d97757", "light": "#d97757" },
      "deepseek": { "dark": "#4d6bfe", "light": "#4d6bfe" }
    },
    {
      "token": "--dsw-alias-brand-text",
      "claude": { "dark": "#faf9f5", "light": "#faf9f5" },
      "deepseek": { "dark": "#eef1f8", "light": "#fafbff" }
    },
    {
      "token": "--dsw-alias-button-primary-fill",
      "claude": { "dark": "#d97757", "light": "#d97757" },
      "deepseek": { "dark": "#4d6bfe", "light": "#4d6bfe" },
      "note": "The host takes a primary button's fill from --dsw-alias-brand-primary but its hover from a monochrome step of its own scale, so both steps are stated here and the hover stays in the fill's family."
    },
    {
      "token": "--dsw-alias-button-primary-hover",
      "claude": { "dark": "#e08a6d", "light": "#c6613f" },
      "deepseek": { "dark": "#6a84ff", "light": "#3a57e8" }
    },
    {
      "token": "--dsw-alias-button-elevated-fill",
      "claude": { "dark": "#242320", "light": "#ffffff" },
      "deepseek": { "dark": "#212631" },
      "note": "Palette-specific, like the solid hover chip: in light the host paints this surface lighter than the canvas, and the light ink it carries needs a light fill."
    },
    {
      "token": "--dsw-alias-button-floating-fill",
      "claude": { "dark": "#242320", "light": "#ffffff" },
      "deepseek": { "dark": "#212631" }
    },
    {
      "token": "--dsw-alias-button-floating-hover",
      "claude": { "dark": "#2e2c29", "light": "#ffffff" },
      "deepseek": { "dark": "#2a303c" }
    },
    {
      "token": "--dsw-alias-button-info-fill",
      "claude": { "dark": "#d97757", "light": "#d97757" },
      "deepseek": { "dark": "#4d6bfe", "light": "#4d6bfe" }
    },
    {
      "token": "--dsw-alias-button-info-hover",
      "claude": { "dark": "#e08a6d", "light": "#c6613f" },
      "deepseek": { "dark": "#6a84ff", "light": "#3a57e8" }
    },
    {
      "token": "--dsw-alias-interactive-bg-active",
      "claude": { "dark": "rgba(217, 119, 87, 0.30)", "light": "rgba(217, 119, 87, 0.30)" },
      "deepseek": { "dark": "rgba(77, 107, 254, 0.30)", "light": "rgba(77, 107, 254, 0.22)" }
    },
    {
      "token": "--dsh-claude-hover-bg",
      "use": "hover wash",
      "claude": { "dark": "rgba(255, 255, 255, 0.08)", "light": "rgba(0, 0, 0, 0.08)" },
      "deepseek": { "light": "rgba(38, 49, 72, 0.08)" },
      "host": "var(--dsw-alias-interactive-bg-hover)"
    },
    {
      "token": "--dsh-claude-inline-code-bg",
      "use": "inline code fill",
      "claude": { "dark": "rgba(255, 255, 255, 0.05)", "light": "rgba(0, 0, 0, 0.05)" },
      "deepseek": { "light": "rgba(38, 49, 72, 0.05)" },
      "host": "var(--dsw-alias-markdown-inline-code)"
    },
    {
      "token": "--dsh-claude-inline-code-fg",
      "use": "inline code ink",
      "claude": { "dark": "#e8a08a", "light": "#943333" },
      "deepseek": { "dark": "var(--dsw-alias-label-primary)", "light": "var(--dsw-alias-label-primary)" },
      "host": "var(--dsw-alias-label-primary)"
    },
    {
      "token": "--dsh-claude-link",
      "use": "markdown links",
      "claude": { "dark": "#8ab4f8", "light": "#184f95" },
      "deepseek": { "dark": "#8fa4ff", "light": "#3b56d9" },
      "host": "var(--dsw-alias-link)"
    },
    {
      "token": "--dsh-claude-link-underline",
      "use": "markdown link underline",
      "claude": { "dark": "rgba(138, 180, 248, 0.6)", "light": "rgba(24, 79, 149, 0.6)" },
      "deepseek": { "dark": "rgba(143, 164, 255, 0.6)", "light": "rgba(59, 86, 217, 0.6)" },
      "host": "color-mix(in srgb, var(--dsw-alias-link) 60%, transparent)"
    },
    {
      "token": "--dsw-alias-markdown-code-block",
      "claude": { "dark": "#1c1b1a", "light": "#ffffff" },
      "deepseek": { "dark": "#1a1e27" },
      "note": "The host pins the code-block surface on `pre.shiki` with !important, so it is only reachable through this token."
    },
    {
      "token": "--dsw-alias-markdown-code-block-banner",
      "claude": { "dark": "#242320", "light": "#ffffff" },
      "deepseek": { "dark": "#212631" }
    },
    {
      "token": "--dsw-alias-interactive-bg-hover",
      "claude": { "dark": "var(--dsh-claude-hover-bg)", "light": "var(--dsh-claude-hover-bg)" }
    },
    {
      "token": "--dsw-alias-interactive-bg-hover-solid",
      "use": "the host's solid hover chip",
      "claude": { "dark": "#2e2c29", "light": "#f0efe9" },
      "deepseek": { "dark": "#2a303c", "light": "#eef3fc" },
      "note": "Palette-specific: in light the host paints a solid hover chip lighter than the canvas, and the light ink it carries needs a light fill."
    },
    {
      "token": "--dsw-alias-label-primary",
      "claude": { "dark": "#faf9f5", "light": "#141413" },
      "deepseek": { "dark": "#eef1f8", "light": "#0f1115" }
    },
    {
      "token": "--dsw-alias-label-primary-bluish",
      "claude": { "dark": "#faf9f5", "light": "#141413" },
      "deepseek": { "dark": "#eef1f8", "light": "#0f1115" }
    },
    {
      "token": "--dsw-alias-label-secondary",
      "claude": { "dark": "#b0aea5", "light": "#6e6a60" },
      "deepseek": { "dark": "#aeb5c4", "light": "#61666b" }
    },
    {
      "token": "--dsw-alias-label-tertiary",
      "claude": { "dark": "#8f8d84", "light": "#8f8a7e" },
      "deepseek": { "dark": "#8a92a3", "light": "#81858c" }
    },
    {
      "token": "--dsw-alias-label-caption",
      "claude": { "dark": "#6b6a65", "light": "#a6a094" },
      "deepseek": { "dark": "#666e7e", "light": "#adb2b8" }
    },
    {
      "token": "--dsw-alias-state-business-primary",
      "claude": { "dark": "#d97757", "light": "#d97757" },
      "deepseek": { "dark": "#6a84ff", "light": "#4d6bfe" }
    },
    {
      "token": "--dsw-alias-state-business-tertiary",
      "claude": { "dark": "#3a2a22", "light": "#e9dfd2" },
      "deepseek": { "dark": "#253056", "light": "#e9eeff" }
    },
    {
      "token": "--dsw-alias-link",
      "use": "text link at rest",
      "claude": { "dark": "#e08a6d", "light": "#c6613f" },
      "deepseek": { "dark": "#8fa4ff", "light": "#3b56d9" }
    },
    {
      "token": "--dsw-shadow-lv2",
      "claude": { "dark": "0 4px 16px rgba(0, 0, 0, 0.30), 0 1px 3px rgba(0, 0, 0, 0.14)", "light": "0 4px 18px rgba(20, 20, 19, 0.10), 0 1px 3px rgba(20, 20, 19, 0.05)" }
    },
    {
      "token": "--dsw-specific-input-major",
      "claude": { "dark": "#0f0e0d", "light": "#ffffff" },
      "deepseek": { "dark": "#0e1117" }
    },
    {
      "token": "--dsw-specific-selector",
      "claude": { "dark": "#2e2c29", "light": "#fbfbf9" },
      "deepseek": { "dark": "#2a303c", "light": "#f7f9ff" }
    },
    {
      "token": "--dsw-specific-sidebar-fill",
      "claude": { "dark": "#141413", "light": "#fbfbf9" },
      "deepseek": { "dark": "#13161d", "light": "#f7f9ff" }
    },
    {
      "token": "--dsw-alias-brand-primary-new-colorprimary-new-color",
      "claude": { "dark": "#d97757", "light": "#d97757" },
      "deepseek": { "dark": "#4d6bfe", "light": "#4d6bfe" },
      "note": "The host's \"new color\" accent ships under this doubled suffix as a deepseek blue in both palettes; the skin has one accent."
    },
    {
      "token": "--dsh-claude-canvas",
      "use": "the page canvas, the search box",
      "claude": { "dark": "#141413", "light": "#fcfcfb" },
      "deepseek": { "dark": "#13161d", "light": "#fafbff" },
      "host": "var(--dsw-alias-bg-base)"
    },
    {
      "token": "--dsh-claude-sidebar-canvas",
      "use": "the sidebar",
      "claude": { "dark": "#141413", "light": "#fbfbf9" },
      "deepseek": { "dark": "#13161d", "light": "#f7f9ff" },
      "host": "var(--dsw-specific-sidebar-fill)"
    },
    {
      "token": "--dsh-claude-raised",
      "use": "popovers and menus raised above the dark canvas",
      "claude": { "dark": "#1e1e1d" },
      "deepseek": { "dark": "#1b1f28" },
      "host": "var(--dsw-alias-bg-overlay)"
    },
    {
      "token": "--dsh-claude-card",
      "use": "cards on the canvas in light and raised in dark: the account popover, the search palette",
      "claude": { "dark": "#1e1e1d", "light": "#fcfcfb" },
      "deepseek": { "dark": "#1b1f28", "light": "#fafbff" },
      "host": "var(--dsw-alias-bg-overlay)"
    },
    {
      "token": "--dsh-claude-inverse-fill",
      "use": "the model picker's group label fill: an inverted chip under Claude, a hover-plate chip under the host",
      "claude": { "dark": "#faf9f5", "light": "#141413" },
      "host": "var(--dsw-alias-interactive-bg-hover)"
    },
    {
      "token": "--dsh-claude-inverse-ink",
      "use": "the model picker's group label ink",
      "claude": { "dark": "#141413", "light": "#faf9f5" },
      "host": "var(--dsw-alias-label-primary)"
    },
    {
      "token": "--dsh-claude-ink-strong",
      "use": "active row ink",
      "claude": { "dark": "#f5f4ef" },
      "deepseek": { "dark": "#e9edf6" },
      "host": "var(--dsw-alias-label-primary)"
    },
    {
      "token": "--dsh-claude-session-ink",
      "use": "session title at rest",
      "claude": { "dark": "#8c8983" },
      "deepseek": { "dark": "#8a91a0" },
      "host": "var(--dsw-alias-label-secondary)"
    },
    {
      "token": "--dsh-claude-table-head",
      "use": "table header row",
      "claude": { "dark": "#242320", "light": "#f0f0ef" },
      "deepseek": { "dark": "#212631", "light": "#eff3fb" },
      "host": "var(--dsw-alias-bg-layer-2)"
    },
    {
      "token": "--dsh-claude-scrollbar",
      "use": "scrollbar thumb",
      "claude": { "dark": "rgba(58, 56, 51, 0.9)", "light": "rgba(208, 205, 193, 0.9)" },
      "deepseek": { "dark": "rgba(54, 61, 75, 0.9)", "light": "rgba(206, 216, 233, 0.9)" },
      "host": "var(--dsw-alias-border-l2)"
    },
    {
      "token": "--dsh-claude-scrollbar-hover",
      "use": "scrollbar thumb under the pointer",
      "claude": { "dark": "rgba(107, 106, 101, 0.9)", "light": "rgba(143, 138, 126, 0.8)" },
      "deepseek": { "dark": "rgba(104, 112, 128, 0.9)", "light": "rgba(129, 133, 140, 0.8)" },
      "host": "var(--dsw-alias-label-caption)"
    },
    {
      "token": "--dsh-claude-link-hover",
      "use": "text link under the pointer",
      "claude": { "dark": "#f0a488", "light": "#a94f2f" },
      "deepseek": { "dark": "#b0c0ff", "light": "#2c43b8" },
      "host": "var(--dsw-alias-link)"
    },
    {
      "token": "--dsh-claude-logo-ink",
      "use": "sidebar brand art: the whale and the wordmark",
      "claude": { "dark": "#faf9f5", "light": "#141413" },
      "deepseek": { "dark": "#4d6bfe", "light": "#4d6bfe" },
      "host": "var(--dsw-alias-label-primary)"
    },
    {
      "token": "--dsw-specific-menu",
      "claude": { "light": "#ffffff" }
    },
    {
      "token": "--dsw-specific-bubble",
      "use": "user message bubble",
      "claude": { "light": "var(--dsh-claude-hover-bg)" },
      "deepseek": { "dark": "#232a3a", "light": "#eaf0fe" },
      "note": "The host's light bubble token is a deepseek blue; the skin's button-hover gray stands in for it."
    },
    {
      "token": "--dsh-claude-chip",
      "use": "segmented control and switch at rest",
      "claude": { "light": "#f6f6f4" },
      "deepseek": { "light": "#f2f6fd" },
      "host": "var(--dsw-specific-selector)"
    },
    {
      "token": "--dsh-claude-meter-peak",
      "use": "the peak rate badge: the expensive end of a provider's own billing clock",
      "claude": { "dark": "#e2a45f", "light": "#a4621d" },
      "deepseek": { "dark": "#e5ae67", "light": "#9a5a1a" },
      "host": "var(--dsw-alias-state-warn-label)"
    },
    {
      "token": "--dsh-claude-meter-valley",
      "use": "the off-peak rate badge, and the dated promotions priced below it",
      "claude": { "dark": "#8cbf96", "light": "#3d7550" },
      "deepseek": { "dark": "#7cc2a0", "light": "#2e7554" },
      "host": "var(--dsw-alias-state-success-primary)"
    }
  ]
}
